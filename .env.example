# Optional local overrides for Docker Compose.
# The project runs without copying this file: docker compose up --build

TODO_APP_HOST_PORT=8080

TODO_DB_NAME=todo
TODO_DB_USERNAME=todo
TODO_DB_PASSWORD=todo-local-password

TODO_KAFKA_ENABLED=true

# Telegram is disabled by default because a real bot token is required.
TODO_TELEGRAM_ENABLED=false
TODO_TELEGRAM_BOT_TOKEN=
